<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Compilar (no requiere Revit instalado: la API se toma de paquetes NuGet de referencia):
        dotnet build -c Release                         Revit 2027 (por defecto, .NET 10)
        dotnet build -c Release -p:RevitVersion=2026    Revit 2025/2026 (.NET 8)
        dotnet build -c Release -p:RevitVersion=2024    Revit 2024 (.NET Framework 4.8)
    En Windows, fuera de CI, el resultado se copia a la carpeta de add-ins de Revit.
  -->
  <PropertyGroup>
    <RevitVersion Condition="'$(RevitVersion)' == ''">2027</RevitVersion>
    <TargetFramework Condition="'$(RevitVersion)' &gt;= '2027'">net10.0-windows</TargetFramework>
    <TargetFramework Condition="'$(RevitVersion)' &gt;= '2025' And '$(RevitVersion)' &lt; '2027'">net8.0-windows</TargetFramework>
    <TargetFramework Condition="'$(RevitVersion)' &lt; '2025'">net48</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>Cad2Revit</AssemblyName>
    <RootNamespace>Cad2Revit</RootNamespace>
    <Version>0.1.0</Version>
    <PlatformTarget>x64</PlatformTarget>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AddinDir>$(AppData)\Autodesk\Revit\Addins\$(RevitVersion)\</AddinDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Cad2Revit.addin" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Instala el add-in en la carpeta de Revit del usuario tras compilar (solo Windows, fuera de CI) -->
  <Target Name="InstalarAddin" AfterTargets="Build" Condition="'$(OS)' == 'Windows_NT' And '$(CI)' != 'true'">
    <MakeDir Directories="$(AddinDir)Cad2Revit" />
    <ItemGroup>
      <Salida Include="$(OutDir)*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(Salida)" DestinationFolder="$(AddinDir)Cad2Revit" />
    <Copy SourceFiles="Cad2Revit.addin" DestinationFolder="$(AddinDir)" />
  </Target>
</Project>
